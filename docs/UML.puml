@startuml Chatterbox
title Chatterbox - Class Diagram (6 design patterns)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Factory Method (Nurzhau)" {
  abstract class MessageCreator {
    + create(roomId, author, content) : Message
    # {abstract} createMessage(roomId, author, content) : Message
  }
  class TextMessageCreator
  class ImageMessageCreator
  class SystemMessageCreator
  class MessageCreatorProvider {
    + forType(type : MessageType) : MessageCreator
  }
  MessageCreator <|-- TextMessageCreator
  MessageCreator <|-- ImageMessageCreator
  MessageCreator <|-- SystemMessageCreator
  MessageCreatorProvider o-- MessageCreator
}

package "Decorator (Nurzhau)" {
  interface MessageView {
    + render() : String
    + tags() : List<String>
  }
  class PlainMessageView
  abstract class MessageDecorator {
    # wrapped : MessageView
  }
  class EmojiDecorator
  class LoggingDecorator
  class EncryptionDecorator {
    + {static} decrypt(cipher : String) : String
  }
  MessageView <|.. PlainMessageView
  MessageView <|.. MessageDecorator
  MessageDecorator o-- MessageView
  MessageDecorator <|-- EmojiDecorator
  MessageDecorator <|-- LoggingDecorator
  MessageDecorator <|-- EncryptionDecorator
}

package "Adapter (Nursultan)" {
  interface ProtocolAdapter<T> {
    + protocolName() : String
    + adapt(payload : T) : IncomingMessage
  }
  class RestProtocolAdapter
  class XmppProtocolAdapter
  class RestPayload <<adaptee>>
  class XmppStanza <<adaptee>>
  class IncomingMessage <<record>>
  ProtocolAdapter <|.. RestProtocolAdapter
  ProtocolAdapter <|.. XmppProtocolAdapter
  RestProtocolAdapter ..> RestPayload
  XmppProtocolAdapter ..> XmppStanza
  ProtocolAdapter ..> IncomingMessage
}

package "Strategy (Nursultan)" {
  interface MessageSortStrategy {
    + key() : String
    + sort(messages : List<Message>) : List<Message>
  }
  class OldestFirstStrategy
  class NewestFirstStrategy
  class AuthorStrategy
  class MessageHistory {
    + setStrategy(key : String)
    + arrange(messages : List<Message>) : List<Message>
  }
  MessageSortStrategy <|.. OldestFirstStrategy
  MessageSortStrategy <|.. NewestFirstStrategy
  MessageSortStrategy <|.. AuthorStrategy
  MessageHistory o-- MessageSortStrategy
}

package "Observer (Gabidin)" {
  interface ChatObserver {
    + onEvent(event : ChatEvent)
  }
  class ChatEventPublisher {
    + subscribe(observer : ChatObserver)
    + unsubscribe(observer : ChatObserver)
    + publish(event : ChatEvent)
  }
  class ConsoleLogObserver
  class UnreadCounterObserver
  class LiveUpdateObserver
  ChatEventPublisher o-- ChatObserver
  ChatObserver <|.. ConsoleLogObserver
  ChatObserver <|.. UnreadCounterObserver
  ChatObserver <|.. LiveUpdateObserver
}

package "Facade (Gabidin)" {
  class ChatFacade {
    + createRoom(name, description) : ChatRoom
    + send(roomId, request) : Message
    + receiveRest(payload) : Message
    + receiveXmpp(xml) : Message
    + history(roomId, sort) : List<Message>
    + stats() : Map
  }
}

class ChatController
class Message

ChatController --> ChatFacade
ChatFacade --> MessageCreatorProvider
ChatFacade ..> MessageView
ChatFacade --> RestProtocolAdapter
ChatFacade --> XmppProtocolAdapter
ChatFacade ..> MessageHistory
ChatFacade --> ChatEventPublisher
MessageCreator ..> Message
@enduml